# AR1 Atendimento — variáveis de ambiente
# Copie para .env.local (nunca versionado) e preencha os valores vazios.

# ---------------------------------------------------------------- Supabase
# A chave publicável pode ficar no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://oflpynhhbcnhcugjxgah.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_QjFpXfgWrhm8DSbeAnsebg_qE7SzBxD

# Chave de serviço (Project Settings → API Keys → service_role / secret).
# Só é usada no servidor: webhook, análise da IA, mídia, documentos de
# contexto (tabela ar1_context_docs e bucket ar1-context) e lista da equipe.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------- IA
# Provedor: "openrouter" (padrão) ou "anthropic".
AI_PROVIDER=openrouter
# Modelo no provedor escolhido.
#   OpenRouter: anthropic/claude-sonnet-5.5   |   Anthropic: claude-sonnet-5-5
AI_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_API_KEY=

# Só se AI_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------- WhatsApp
# Provedor: "bridge" (padrão — ponte local com Evolution API) ou "zapi".
WHATSAPP_PROVIDER=bridge

# Só se WHATSAPP_PROVIDER=zapi (painel da Z-API → sua instância):
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Segredo do webhook. Vira parte da URL:
#   https://SEU-DOMINIO/api/whatsapp/webhook/<WEBHOOK_SECRET>
# e também é aceito no cabeçalho x-internal-secret para chamadas internas.
# Gere algo longo e aleatório (ex.: openssl rand -hex 24).
WEBHOOK_SECRET=

# Opcional: URL pública do app (o webhook usa para chamar a análise).
# Na Vercel, quando vazio, usa VERCEL_PROJECT_PRODUCTION_URL automaticamente.
APP_URL=
