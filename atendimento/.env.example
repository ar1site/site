# AR1 Atendimento — variáveis de ambiente
# Copie para .env.local (nunca versionado) e preencha os valores vazios.

# ---------------------------------------------------------------- Supabase
# A chave publicável pode ficar no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://oflpynhhbcnhcugjxgah.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_QjFpXfgWrhm8DSbeAnsebg_qE7SzBxD

# Chave de serviço (Project Settings → API Keys → service_role / secret).
# Só é usada no servidor: webhook, análise da IA, mídia, documentos de
# contexto (tabela ar1_context_docs e bucket ar1-context) e lista da equipe.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------- IA
# Provedor: "openrouter" (padrão) ou "anthropic".
AI_PROVIDER=openrouter
# Modelo no provedor escolhido.
#   OpenRouter: anthropic/claude-sonnet-5.5   |   Anthropic: claude-sonnet-5-5
AI_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_API_KEY=

# Modelo que transcreve os áudios do WhatsApp. Sempre pela OpenRouter (usa a
# OPENROUTER_API_KEY acima, mesmo com AI_PROVIDER=anthropic) e precisa aceitar
# entrada de áudio.
AI_AUDIO_MODEL=google/gemini-3.5-flash-lite

# Só se AI_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------- WhatsApp
# Provedor: "bridge" (padrão — ponte local com Evolution API) ou "zapi".
WHATSAPP_PROVIDER=bridge

# Só se WHATSAPP_PROVIDER=zapi (painel da Z-API → sua instância):
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Segredo do webhook. Vira parte da URL:
#   https://SEU-DOMINIO/api/whatsapp/webhook/<WEBHOOK_SECRET>
# e também é aceito no cabeçalho x-internal-secret para chamadas internas.
# Gere algo longo e aleatório (ex.: openssl rand -hex 24).
WEBHOOK_SECRET=

# Segredo do cron da Vercel. Vale para as duas rotinas diárias (vercel.json):
#   08:00 de Brasília  /api/followups/gerar  (retomadas sugeridas)
#   08:10 de Brasília  /api/resumo/diario    (resumo no WhatsApp do dono)
# A Vercel manda "Authorization: Bearer <CRON_SECRET>". Sem esta variável, o
# cron é recusado (401): as retomadas só saem pelo botão "Gerar agora" e o
# resumo só sai pelo botão "Enviar agora" (Ajustes → Resumo diário).
# Gere algo longo e aleatório (ex.: openssl rand -hex 24).
CRON_SECRET=

# Opcional: URL pública do app (o webhook usa para chamar a análise).
# Na Vercel, quando vazio, usa VERCEL_PROJECT_PRODUCTION_URL automaticamente.
APP_URL=

# ------------------------------------------- Propostas em PDF e resumo diário
# Não pedem variável nova. Usam o que já está acima:
#   - IA: AI_PROVIDER / AI_MODEL (rascunho da proposta e texto do resumo).
#   - SUPABASE_SERVICE_ROLE_KEY: guarda o PDF no bucket privado "ar1-context"
#     (pasta propostas/) e cria o link assinado de 7 dias.
#   - WHATSAPP_PROVIDER: o link da proposta e o resumo saem pela fila de envio.
# O que se ajusta pela tela (tabela ar1_settings), não por variável:
#   resumo.ativo          true | false                 (padrão: true)
#   resumo.destinatarios  ["556281069562"]             (só dígitos, com DDI)
#   resumo.ultimo_envio   gravado pelo sistema (trava de um envio por dia)
# As propostas precisam da migração 20260930100000_ar1_propostas.sql.
