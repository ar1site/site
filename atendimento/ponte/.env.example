# Copie este arquivo para ".env" (mesma pasta) e preencha.
# O .env é lido pelo docker compose; nunca é versionado.

# Chave da Evolution API. Gere algo longo e aleatório, por exemplo no PowerShell:
#   -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
# Use o MESMO valor em EVOLUTION_APIKEY do arquivo
#   %LOCALAPPDATA%\SistemaACM\ar1-ponte.env
EVOLUTION_APIKEY=

# Opcional: senha do Postgres local (só a Evolution usa; fica dentro do Docker).
# POSTGRES_PASSWORD=evolution_local
